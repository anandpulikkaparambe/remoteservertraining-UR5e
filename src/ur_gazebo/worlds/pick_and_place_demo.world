<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="lego_sorting">
    <physics name="bullet_featherstone_physics" type="bullet_featherstone">
      <bullet>
        <solver>
          <type>btSequentialImpulseConstraintSolver</type>
        </solver>
        <featherstone>true</featherstone>
      </bullet>
      <max_step_size>0.001</max_step_size>
      <!-- Uncapped (2026-09-09): was hardcoded to 1 (real-time), throttling headless
           training to wall-clock pace even with idle CPU to spare; confirmed live on a
           Vast.ai instance (load average 7-8/16 while training throughput stayed flat).
           0 = run physics as fast as the CPU allows; max_step_size above (fidelity) is
           unchanged, only pacing changes. -->
      <real_time_factor>0</real_time_factor>
      <damping>0.1</damping>
      <gravity>0.0 0.0 -9.8</gravity>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>true</publish_link_pose>
      <publish_nested_model_pose>true</publish_nested_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <static_publisher>true</static_publisher>
      <static_update_frequency>1</static_update_frequency>
    </plugin>

    <!-- Lighting -->
    <light type="directional" name="sun_dir">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane</uri>
    </include>

    <scene>
      <ambient>0.8 0.8 0.8 1.0</ambient>
      <background>0.5 0.5 0.5 1.0</background>
      <shadows>true</shadows>
    </scene>

    <!-- Main Table with 4 Legs (Height 0.8m) -->
    <model name="table">
      <static>true</static>
      <!-- Base coordinate for the whole model -->
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        
        <!-- Table Top -- X half-width grown 0.5 -> 0.95 on 2026-09-03: the real-hardware-matched
             lego position (x=0.802) fell off the old table's edge (old X range was only
             [-0.5, 0.5]) straight through to the ground plane. Y half-width grown 0.8 -> 1.3
             the same day, once the bin's Y-offset bug was fixed (0.55 + 0.608 = 1.158) --
             the old Y range didn't cover that either. -->
        <collision name="top_collision">
          <pose>0 0 0.78 0 0 0</pose>
          <geometry><box><size>1.9 2.6 0.04</size></box></geometry>
        </collision>
        <visual name="top_visual">
          <pose>0 0 0.78 0 0 0</pose>
          <geometry><box><size>1.9 2.6 0.04</size></box></geometry>
          <material>
            <ambient>0.4 0.2 0.05 1</ambient>
            <diffuse>0.5 0.25 0.1 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
        
        <!-- Legs moved to the new corners 2026-09-03 (X: +-0.46 -> +-0.91, Y: +-0.76 -> +-1.26),
             same 0.04m margin-from-edge convention as before, matching the enlarged table top. -->
        <!-- Leg 1 (Front Left) -->
        <collision name="leg1_collision"><pose>-0.91 -1.26 0.38 0 0 0</pose><geometry><box><size>0.04 0.04 0.76</size></box></geometry></collision>
        <visual name="leg1_visual"><pose>-0.91 -1.26 0.38 0 0 0</pose><geometry><box><size>0.04 0.04 0.76</size></box></geometry><material><ambient>0.4 0.2 0.05 1</ambient><diffuse>0.5 0.25 0.1 1</diffuse></material></visual>

        <!-- Leg 2 (Front Right) -->
        <collision name="leg2_collision"><pose>0.91 -1.26 0.38 0 0 0</pose><geometry><box><size>0.04 0.04 0.76</size></box></geometry></collision>
        <visual name="leg2_visual"><pose>0.91 -1.26 0.38 0 0 0</pose><geometry><box><size>0.04 0.04 0.76</size></box></geometry><material><ambient>0.4 0.2 0.05 1</ambient><diffuse>0.5 0.25 0.1 1</diffuse></material></visual>

        <!-- Leg 3 (Back Left) -->
        <collision name="leg3_collision"><pose>-0.91 1.26 0.38 0 0 0</pose><geometry><box><size>0.04 0.04 0.76</size></box></geometry></collision>
        <visual name="leg3_visual"><pose>-0.91 1.26 0.38 0 0 0</pose><geometry><box><size>0.04 0.04 0.76</size></box></geometry><material><ambient>0.4 0.2 0.05 1</ambient><diffuse>0.5 0.25 0.1 1</diffuse></material></visual>

        <!-- Leg 4 (Back Right) -->
        <collision name="leg4_collision"><pose>0.91 1.26 0.38 0 0 0</pose><geometry><box><size>0.04 0.04 0.76</size></box></geometry></collision>
        <visual name="leg4_visual"><pose>0.91 1.26 0.38 0 0 0</pose><geometry><box><size>0.04 0.04 0.76</size></box></geometry><material><ambient>0.4 0.2 0.05 1</ambient><diffuse>0.5 0.25 0.1 1</diffuse></material></visual>
        
      </link>
    </model>

    <!-- Sorting Bin (Hollow, Red/translucent) -->
    <model name="bin">
        <!-- XY updated 2026-09-03 to match real hardware's taught bin waypoint, TF-measured
             in base_link frame (real_bin_position, see project_real_hardware_setup memory):
             horizontal distance from base was 0.43m in sim vs 0.74m real. Z left unchanged --
             sim Z is world-ground-plane-relative, real Z is base_link-mount-relative, and the
             offset between those two references hasn't been measured, so changing Z here would
             be a guess, not a fix. -->
        <!-- Y corrected 2026-09-03: world Y must be true_base_Y (0.55) + real offset (0.608),
             not the raw real offset alone -- same arithmetic mistake as the lego pose. -->
        <pose>0.415 1.158 0.85 0 0 0</pose>
        <static>true</static>
        <link name="link">
            
            <!-- Base -->
            <collision name="base_coll"><pose>0 0 -0.045 0 0 0</pose><geometry><box><size>0.2 0.2 0.01</size></box></geometry></collision>
            <visual name="base_vis"><pose>0 0 -0.045 0 0 0</pose><geometry><box><size>0.2 0.2 0.01</size></box></geometry>
                <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.8 0.2 0.2 0.5</diffuse></material></visual>
            
            <!-- Left Wall -->
            <collision name="wall1_coll"><pose>0.095 0 0 0 0 0</pose><geometry><box><size>0.01 0.2 0.1</size></box></geometry></collision>
            <visual name="wall1_vis"><pose>0.095 0 0 0 0 0</pose><geometry><box><size>0.01 0.2 0.1</size></box></geometry>
                <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.8 0.2 0.2 0.5</diffuse></material></visual>

            <!-- Right Wall -->
            <collision name="wall2_coll"><pose>-0.095 0 0 0 0 0</pose><geometry><box><size>0.01 0.2 0.1</size></box></geometry></collision>
            <visual name="wall2_vis"><pose>-0.095 0 0 0 0 0</pose><geometry><box><size>0.01 0.2 0.1</size></box></geometry>
                <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.8 0.2 0.2 0.5</diffuse></material></visual>

            <!-- Front Wall -->
            <collision name="wall3_coll"><pose>0 0.095 0 0 0 0</pose><geometry><box><size>0.18 0.01 0.1</size></box></geometry></collision>
            <visual name="wall3_vis"><pose>0 0.095 0 0 0 0</pose><geometry><box><size>0.18 0.01 0.1</size></box></geometry>
                <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.8 0.2 0.2 0.5</diffuse></material></visual>

            <!-- Back Wall -->
            <collision name="wall4_coll"><pose>0 -0.095 0 0 0 0</pose><geometry><box><size>0.18 0.01 0.1</size></box></geometry></collision>
            <visual name="wall4_vis"><pose>0 -0.095 0 0 0 0</pose><geometry><box><size>0.18 0.01 0.1</size></box></geometry>
                <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.8 0.2 0.2 0.5</diffuse></material></visual>

        </link>
    </model>

    <!-- Lego Bricks with Studs -->
    <model name="lego_red">
      <!-- XY updated 2026-09-03 to match real hardware's taught pick waypoint, TF-measured in
           base_link frame (real_pick_position): horizontal distance from base was 0.36m in sim
           vs 0.84m real -- see project_phase2_rl_status memory. Z left unchanged, same
           world-vs-base_link-frame caveat as the bin pose below. -->
      <!-- Y corrected 2026-09-03: world Y must be true_base_Y (0.55) + real offset (-0.260),
           not the raw real offset alone -- an arithmetic mistake in the first pass here put
           it at -0.260 directly. -->
      <pose>0.802 0.290 0.85 0 0 0</pose>
      <link name="link">
        <inertial>
            <mass>0.05</mass>
            <inertia><ixx>0.00005</ixx><iyy>0.00005</iyy><izz>0.00005</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.020 0.020 0.020</size></box> <!-- Real block measured 2026-09-03: ~20mm across, consistent from two grasp angles 90deg apart. Was 0.057 (Rubik's-cube-sized guess). -->
          </geometry>
          <!-- No surface/friction was defined at all before, leaving grip reliability to
               Bullet's default for an unspecified surface; explicit high friction here
               so a closed gripper actually holds this block through the transport-to-bin
               motion instead of relying on an unstated default. -->
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="base_visual">
          <geometry>
            <box><size>0.020 0.020 0.020</size></box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
        <!-- Studs -->
        <visual name="stud1">
          <pose>0.008 0.008 0.012 0 0 0</pose>
          <geometry><cylinder><radius>0.0024</radius><length>0.004</length></cylinder></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
        <visual name="stud2">
          <pose>0.008 -0.008 0.012 0 0 0</pose>
          <geometry><cylinder><radius>0.0024</radius><length>0.004</length></cylinder></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
        <visual name="stud3">
          <pose>-0.008 0.008 0.012 0 0 0</pose>
          <geometry><cylinder><radius>0.0024</radius><length>0.004</length></cylinder></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
        <visual name="stud4">
          <pose>-0.008 -0.008 0.012 0 0 0</pose>
          <geometry><cylinder><radius>0.0024</radius><length>0.004</length></cylinder></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="lego_blue">
      <pose>0.3 -0.2 0.82 0 0 0</pose>
      <link name="link">
        <inertial>
            <mass>0.01</mass>
            <inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.032 0.032 0.02</size></box>
          </geometry>
        </collision>
        <visual name="base_visual">
          <geometry>
            <box><size>0.032 0.032 0.02</size></box>
          </geometry>
          <material>
            <ambient>0 0 1 1</ambient>
            <diffuse>0 0 1 1</diffuse>
          </material>
        </visual>
        <!-- Studs -->
        <visual name="stud1"><pose>0.008 0.008 0.012 0 0 0</pose><geometry><cylinder><radius>0.0024</radius><length>0.004</length></cylinder></geometry><material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material></visual>
        <visual name="stud2"><pose>0.008 -0.008 0.012 0 0 0</pose><geometry><cylinder><radius>0.0024</radius><length>0.004</length></cylinder></geometry><material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material></visual>
        <visual name="stud3"><pose>-0.008 0.008 0.012 0 0 0</pose><geometry><cylinder><radius>0.0024</radius><length>0.004</length></cylinder></geometry><material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material></visual>
        <visual name="stud4"><pose>-0.008 -0.008 0.012 0 0 0</pose><geometry><cylinder><radius>0.0024</radius><length>0.004</length></cylinder></geometry><material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material></visual>
      </link>
    </model>

    <model name="lego_green">
      <pose>0.4 0.0 0.82 0 0 0.785</pose>
      <link name="link">
        <inertial>
            <mass>0.01</mass>
            <inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.032 0.032 0.02</size></box>
          </geometry>
        </collision>
        <visual name="base_visual">
          <geometry>
            <box><size>0.032 0.032 0.02</size></box>
          </geometry>
          <material>
            <ambient>0 1 0 1</ambient>
            <diffuse>0 1 0 1</diffuse>
          </material>
        </visual>
        <!-- Studs -->
        <visual name="stud1"><pose>0.008 0.008 0.012 0 0 0</pose><geometry><cylinder><radius>0.0024</radius><length>0.004</length></cylinder></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material></visual>
        <visual name="stud2"><pose>0.008 -0.008 0.012 0 0 0</pose><geometry><cylinder><radius>0.0024</radius><length>0.004</length></cylinder></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material></visual>
        <visual name="stud3"><pose>-0.008 0.008 0.012 0 0 0</pose><geometry><cylinder><radius>0.0024</radius><length>0.004</length></cylinder></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material></visual>
        <visual name="stud4"><pose>-0.008 -0.008 0.012 0 0 0</pose><geometry><cylinder><radius>0.0024</radius><length>0.004</length></cylinder></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material></visual>
      </link>
    </model>

    <model name="lego_yellow">
      <pose>0.35 -0.1 0.82 0 0 0.2</pose>
      <link name="link">
        <inertial>
            <mass>0.01</mass>
            <inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.032 0.032 0.02</size></box>
          </geometry>
        </collision>
        <visual name="base_visual">
          <geometry>
            <box><size>0.032 0.032 0.02</size></box>
          </geometry>
          <material>
            <ambient>1 1 0 1</ambient>
            <diffuse>1 1 0 1</diffuse>
          </material>
        </visual>
        <!-- Studs -->
        <visual name="stud1"><pose>0.008 0.008 0.012 0 0 0</pose><geometry><cylinder><radius>0.0024</radius><length>0.004</length></cylinder></geometry><material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material></visual>
        <visual name="stud2"><pose>0.008 -0.008 0.012 0 0 0</pose><geometry><cylinder><radius>0.0024</radius><length>0.004</length></cylinder></geometry><material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material></visual>
        <visual name="stud3"><pose>-0.008 0.008 0.012 0 0 0</pose><geometry><cylinder><radius>0.0024</radius><length>0.004</length></cylinder></geometry><material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material></visual>
        <visual name="stud4"><pose>-0.008 -0.008 0.012 0 0 0</pose><geometry><cylinder><radius>0.0024</radius><length>0.004</length></cylinder></geometry><material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material></visual>
      </link>
    </model>

    <!-- GUI Camera (User View) -->
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>1.6 -1.2 1.8 0 0.5 2.5</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <!-- Overhead Camera (Adjusted Pose) -->
    <model name="camera">
      <pose>0.3 0.0 1.5 0 1.5708 0</pose> 
      <link name="link">
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.000166667</ixx>
            <iyy>0.000166667</iyy>
            <izz>0.000166667</izz>
          </inertia>
        </inertial>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 0.1 0.1</size>
            </box>
          </geometry>
        </visual>
        <sensor name="camera" type="camera">
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
          <topic>camera/image_raw</topic>
        </sensor>
        
        <!-- Depth Camera Sensor -->
        <sensor name="depth_camera" type="depth_camera">
          <update_rate>30</update_rate>
          <topic>camera/depth_image</topic>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R_FLOAT32</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
          </camera>
          <always_on>1</always_on>
          <visualize>true</visualize>
        </sensor>
      </link>
      <static>true</static>
    </model>

  </world>
</sdf>
