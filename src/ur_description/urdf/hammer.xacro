<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="hammer">
    <xacro:macro name="hammer" params="prefix parent">
        <!-- Joint attaching the Hammer to the Parent (tool0) -->
        <joint name="${prefix}hammer_joint" type="fixed">
            <parent link="${parent}"/>
            <child link="${prefix}hammer_base_link"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </joint>

        <!-- The Handle -->
        <link name="${prefix}hammer_base_link">
            <visual>
                <origin xyz="0 0 0.1" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="0.015" length="0.2"/>
                </geometry>
                <material name="wood">
                    <color rgba="0.6 0.4 0.2 1.0"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0.1" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="0.015" length="0.2"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0 0 0.1" rpy="0 0 0"/>
                <mass value="0.2"/>
                <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0001"/>
            </inertial>
        </link>

        <!-- Joint attaching Head to Handle -->
        <joint name="${prefix}hammer_head_joint" type="fixed">
            <parent link="${prefix}hammer_base_link"/>
            <child link="${prefix}hammer_head"/>
            <!-- Attach at the very end of the handle (Z=0.2) -->
            <origin xyz="0 0 0.2" rpy="0 0 0"/>
        </joint>

        <!-- The Head -->
        <link name="${prefix}hammer_head">
            <visual>
                <!-- Rotate cylinder 90 degrees to lay across the X axis -->
                <origin xyz="0.02 0 0" rpy="0 1.5708 0"/>
                <geometry>
                    <cylinder radius="0.02" length="0.1"/>
                </geometry>
                <material name="metal">
                    <color rgba="0.8 0.8 0.8 1.0"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0.02 0 0" rpy="0 1.5708 0"/>
                <geometry>
                    <cylinder radius="0.02" length="0.1"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0.02 0 0" rpy="0 0 0"/>
                <mass value="0.5"/>
                <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
            </inertial>
        </link>

    </xacro:macro>
</robot>
