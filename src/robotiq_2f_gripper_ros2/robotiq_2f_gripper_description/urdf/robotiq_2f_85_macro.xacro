<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="robotiq_arg2f_85">

  <xacro:include filename="$(find robotiq_2f_gripper_description)/urdf/robotiq_arg2f_transmission.xacro" />

  <xacro:macro name="robotiq_arg2f_base_link_85" params="prefix">
    <link name="${prefix}robotiq_arg2f_base_link">
      <inertial>
        <origin xyz="8.625E-08 -4.6583E-06 0.03145" rpy="0 0 0" />
        <mass value="0.22652" />
        <inertia ixx="0.00020005" ixy="0" ixz="0" iyy="0.00017832" iyz="0" izz="0.00013478" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://robotiq_2f_gripper_description/meshes/visual/robotiq_arg2f_85_base_link.dae" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="black">
          <color rgba="0.1 0.1 0.1 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://robotiq_2f_gripper_description/meshes/collision/robotiq_arg2f_85_base_link.stl" />
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:macro name="outer_knuckle_85" params="prefix fingerprefix">
    <link name="${prefix}${fingerprefix}_outer_knuckle">
      <inertial>
        <origin xyz="-0.0002 0.0199 0.0292" rpy="0 0 0" />
        <mass value="0.0085" />
        <inertia ixx="2.89e-06" ixy="0" ixz="0" iyy="1.86e-06" iyz="-1.21e-06" izz="1.21e-06" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://robotiq_2f_gripper_description/meshes/visual/robotiq_arg2f_85_outer_knuckle.dae" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="silver">
          <color rgba="0.79 0.82 0.93 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://robotiq_2f_gripper_description/meshes/collision/robotiq_arg2f_85_outer_knuckle.dae" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:macro name="outer_finger_85" params="prefix fingerprefix">
    <link name="${prefix}${fingerprefix}_outer_finger">
      <inertial>
        <origin xyz="0.0003 0.0373 -0.0208" rpy="0 0 0" />
        <mass value="0.0226" />
        <inertia ixx="1.52e-05" ixy="0" ixz="0" iyy="6.17e-06" iyz="6.78e-06" izz="1.16e-05" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://robotiq_2f_gripper_description/meshes/visual/robotiq_arg2f_85_outer_finger.dae" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="black">
          <color rgba="0.1 0.1 0.1 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://robotiq_2f_gripper_description/meshes/collision/robotiq_arg2f_85_outer_finger.dae" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:macro name="inner_knuckle_85" params="prefix fingerprefix">
    <link name="${prefix}${fingerprefix}_inner_knuckle">
      <inertial>
        <origin xyz="0.0001 0.0507 0.0010" rpy="0 0 0" />
        <mass value="0.0271" />
        <inertia ixx="2.61e-05" ixy="0" ixz="0" iyy="2.82e-06" iyz="-5.37e-07" izz="2.83e-05" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://robotiq_2f_gripper_description/meshes/visual/robotiq_arg2f_85_inner_knuckle.dae" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://robotiq_2f_gripper_description/meshes/collision/robotiq_arg2f_85_inner_knuckle.dae" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:macro name="inner_finger_85" params="prefix fingerprefix">
    <link name="${prefix}${fingerprefix}_inner_finger">
      <inertial>
        <origin xyz="0.0003 0.0160 -0.0136" rpy="0 0 0" />
        <mass value="0.0104" />
        <inertia ixx="2.71e-06" ixy="0" ixz="0" iyy="7.69e-07" iyz="6.74e-07" izz="2.30e-06" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://robotiq_2f_gripper_description/meshes/visual/robotiq_arg2f_85_inner_finger.dae" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://robotiq_2f_gripper_description/meshes/collision/robotiq_arg2f_85_inner_finger.dae" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <!-- Finger pad: plain box, no mesh (same approach the 140 macro uses). Real 2F-85
       pad footprint (from KevinGalassi/Robotiq-2f-85's own model): 22mm x 6.35mm x 37.5mm,
       notably smaller/thinner than the 140's 27x65x7.5mm pad, not a scaled copy. -->
  <xacro:macro name="inner_finger_pad_85" params="prefix fingerprefix">
    <link name="${prefix}${fingerprefix}_inner_finger_pad">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.003" />
        <inertia ixx="2.5E-07" ixy="0" ixz="0" iyy="3.5E-07" iyz="0" izz="1.5E-07" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.022 0.00635 0.0375"/>
        </geometry>
        <material name="gray">
          <color rgba="0.9 0.9 0.9 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.022 0.00635 0.0375"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:macro name="outer_finger_joint_85" params="prefix fingerprefix">
    <joint name="${prefix}${fingerprefix}_outer_finger_joint" type="fixed">
      <origin xyz="0 0.0315 -0.0041" rpy="0 0 0" />
      <parent link="${prefix}${fingerprefix}_outer_knuckle" />
      <child link="${prefix}${fingerprefix}_outer_finger" />
    </joint>
  </xacro:macro>

  <xacro:macro name="inner_knuckle_joint_85" params="prefix fingerprefix reflect">
    <joint name="${prefix}${fingerprefix}_inner_knuckle_joint" type="revolute">
      <origin xyz="0 ${reflect * -0.0127} 0.06142" rpy="0 0 ${(1 + reflect) * pi / 2}" />
      <parent link="${prefix}robotiq_arg2f_base_link" />
      <child link="${prefix}${fingerprefix}_inner_knuckle" />
      <axis xyz="1 0 0" />
      <limit lower="0" upper="0.8757" velocity="2.0" effort="1000" />
      <mimic joint="${prefix}finger_joint" multiplier="1" offset="0" />
    </joint>
  </xacro:macro>

  <xacro:macro name="inner_finger_joint_85" params="prefix fingerprefix">
    <joint name="${prefix}${fingerprefix}_inner_finger_joint" type="revolute">
      <origin xyz="0 0.0061 0.0471" rpy="0 0 0" />
      <parent link="${prefix}${fingerprefix}_outer_finger" />
      <child link="${prefix}${fingerprefix}_inner_finger" />
      <axis xyz="1 0 0" />
      <limit lower="-0.8757" upper="0" velocity="2.0" effort="1000" />
      <mimic joint="${prefix}finger_joint" multiplier="-1" offset="0" />
    </joint>
  </xacro:macro>

  <xacro:macro name="inner_finger_pad_joint_85" params="prefix fingerprefix">
    <joint name="${prefix}${fingerprefix}_inner_finger_pad_joint" type="fixed">
      <origin xyz="0 -0.0220 0.03242" rpy="0 0 0" />
      <parent link="${prefix}${fingerprefix}_inner_finger" />
      <child link="${prefix}${fingerprefix}_inner_finger_pad" />
    </joint>
  </xacro:macro>

  <!-- Gazebo mimic plugin placeholder, same no-op pattern as the 140 macro: mimic
       joints are enforced through ros2_control's <param name="mimic"> config
       (ur.ros2_control.xacro), not a Gazebo-side plugin. -->
  <xacro:macro name="finger_mimic_plugin_85" params="prefix fingerprefix">
    <gazebo>
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>
    </gazebo>
    <gazebo reference="${prefix}${fingerprefix}_inner_knuckle_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>
    <gazebo reference="${prefix}${fingerprefix}_inner_finger_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="robotiq_arg2f_85" params="prefix">
    <xacro:robotiq_arg2f_base_link_85 prefix="${prefix}"/>

    <xacro:outer_knuckle_85 prefix="${prefix}" fingerprefix="left"/>
    <xacro:outer_finger_85 prefix="${prefix}" fingerprefix="left"/>
    <xacro:inner_knuckle_85 prefix="${prefix}" fingerprefix="left"/>
    <xacro:inner_finger_85 prefix="${prefix}" fingerprefix="left"/>
    <xacro:inner_finger_pad_85 prefix="${prefix}" fingerprefix="left"/>

    <xacro:outer_finger_joint_85 prefix="${prefix}" fingerprefix="left"/>
    <xacro:inner_knuckle_joint_85 prefix="${prefix}" fingerprefix="left" reflect="1.0"/>
    <xacro:inner_finger_joint_85 prefix="${prefix}" fingerprefix="left"/>
    <xacro:inner_finger_pad_joint_85 prefix="${prefix}" fingerprefix="left"/>

    <xacro:outer_knuckle_85 prefix="${prefix}" fingerprefix="right"/>
    <xacro:outer_finger_85 prefix="${prefix}" fingerprefix="right"/>
    <xacro:inner_knuckle_85 prefix="${prefix}" fingerprefix="right"/>
    <xacro:inner_finger_85 prefix="${prefix}" fingerprefix="right"/>
    <xacro:inner_finger_pad_85 prefix="${prefix}" fingerprefix="right"/>

    <xacro:outer_finger_joint_85 prefix="${prefix}" fingerprefix="right"/>
    <xacro:inner_knuckle_joint_85 prefix="${prefix}" fingerprefix="right" reflect="-1.0"/>
    <xacro:inner_finger_joint_85 prefix="${prefix}" fingerprefix="right"/>
    <xacro:inner_finger_pad_joint_85 prefix="${prefix}" fingerprefix="right"/>

    <joint name="${prefix}finger_joint" type="revolute">
      <origin xyz="0 -0.0306011 0.054904" rpy="0 0 ${pi}" />
      <parent link="${prefix}robotiq_arg2f_base_link" />
      <child link="${prefix}left_outer_knuckle" />
      <axis xyz="1 0 0" />
      <limit lower="0" upper="0.8" velocity="2.0" effort="1000" />
    </joint>

    <joint name="${prefix}right_outer_knuckle_joint" type="revolute">
      <origin xyz="0 0.0306011 0.054904" rpy="0 0 0" />
      <parent link="${prefix}robotiq_arg2f_base_link" />
      <child link="${prefix}right_outer_knuckle" />
      <axis xyz="1 0 0" />
      <limit lower="0" upper="0.81" velocity="2.0" effort="1000" />
      <mimic joint="${prefix}finger_joint" multiplier="1" offset="0" />
    </joint>

    <xacro:robotiq_arg2f_transmission prefix="${prefix}"/>
    <xacro:finger_mimic_plugin_85 prefix="${prefix}" fingerprefix="left"/>
    <xacro:finger_mimic_plugin_85 prefix="${prefix}" fingerprefix="right"/>
  </xacro:macro>

</robot>
